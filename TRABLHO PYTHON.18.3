Arquivo 2: tarefas.py

(Copie o código abaixo e salve exatamente com o nome tarefas.py dentro da pasta atividade_engenharia_reversa).
python
opcao = -1

while opcao != 0:
    print("\n===== MENU DE TAREFAS =====")
    print("1 - Cadastrar tarefa")
    print("2 - Listar tarefas")
    print("3 - Quantidade de tarefas cadastradas")
    print("0 - Sair")
    
    opcao = int(input("Escolha uma opção: "))
    
    if opcao == 1:
        tarefa = input("Digite a tarefa: ")
        arquivo = open("tarefas.txt", "a", encoding="utf-8")
        arquivo.write(tarefa + "\n")
        arquivo.close()
        print("Tarefa cadastrada!")
        
    elif opcao == 2:
        try:
            arquivo = open("tarefas.txt", "r", encoding="utf-8")
            linhas = arquivo.readlines()
            arquivo.close()
            
            print("\n===== LISTA DE TAREFAS =====")
            if len(linhas) == 0:
                print("Nenhuma tarefa cadastrada ainda.")
            else:
                for tarefa in linhas:
                    print(tarefa.strip())
        except FileNotFoundError:
            print("\nNenhuma tarefa cadastrada ainda.")
            
    elif opcao == 3:
        try:
            arquivo = open("tarefas.txt", "r", encoding="utf-8")
            linhas = arquivo.readlines()
            arquivo.close()
            
            print(f"\nQuantidade de tarefas cadastradas: {len(linhas)}")
        except FileNotFoundError:
            print("\nQuantidade de tarefas cadastradas: 0")
            
    elif opcao == 0:
        print("Programa encerrado!")
        
    else:
        print("Opção inválida!")
