 Exercício 2: Somador de Números
 

  
# Exercício 2 - Somador de Números
soma = 0
numero = int(input("Digite um número (0 para parar): "))

while numero != 0:
    soma = soma + numero
    numero = int(input("Digite um número (0 para parar): "))

print(f"A soma total é: {soma}")

 
