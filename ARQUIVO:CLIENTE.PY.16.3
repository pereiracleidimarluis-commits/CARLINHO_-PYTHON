import socket

HOST = '127.0.0.1'
PORT = 5000

with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
    s.connect((HOST, PORT))
    nome = input("Digite o primeiro nome do aluno: ")
    s.sendall(nome.encode('utf-8'))
    resposta = s.recv(1024).decode('utf-8')
    print(f"Resposta do servidor: {resposta}")
