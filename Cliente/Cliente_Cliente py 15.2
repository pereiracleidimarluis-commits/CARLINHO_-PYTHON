import socket
 HOST = '127.0.0.1'
 PORTA = 5000
 nome = input("Digite o primeiro nome do aluno: ")
 cliente = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
 cliente.connect((HOST, PORTA))
 cliente.send(nome.encode('utf-8'))
 resposta = cliente.recv(1024).decode('utf-8')
 print(resposta)
 cliente.close()
