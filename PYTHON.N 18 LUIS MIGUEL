​Etapa 4 e 5 – Código Corrigido (tarefas.py) com o Desafio (Opção 3)
​O código abaixo corrige todos os problemas apontados, garante que as tarefas anteriores não sejam apagadas, coloca cada tarefa em uma linha diferente e já inclui a Opção 3
(Quantidade e listagem de tarefas cadastradas) solicitada no desafio individual:

opcao = -1

while opcao != 0:
    print("\n===== MENU DE TAREFAS =====")
    print("1 - Cadastrar tarefa")
    print("2 - Listar tarefas")
    print("3 - Quantidade de tarefas cadastradas")
    print("0 - Sair")

    opcao = int(input("Escolha uma opção: "))

    if opcao == 1:
        tarefa = input("Digite a tarefa: ")

        # Alterado para "a" (append) para adicionar ao final sem apagar as anteriores
        # Adicionado "\n" para que cada tarefa fique em uma linha separada
        arquivo = open("tarefas.txt", "a", encoding="utf-8")
        arquivo.write(tarefa + "\n")
        arquivo.close()

        print("Tarefa cadastrada com sucesso!")

    elif opcao == 2:
        try:
            arquivo = open("tarefas.txt", "r", encoding="utf-8")
            linhas = arquivo.readlines()
            arquivo.close()

            print("\n===== LISTA DE TAREFAS =====")
            if not linhas:
                print("Nenhuma tarefa cadastrada.")
            else:
                for i, tarefa in enumerate(linhas, 1):
                    print(f"{i}. {tarefa.strip()}")
        except FileNotFoundError:
            print("\n===== LISTA DE TAREFAS =====")
            print("Nenhuma tarefa cadastrada ainda (arquivo não encontrado).")

    elif opcao == 3:
        # Desafio individual: Informa a quantidade e quais tarefas estão registradas
        try:
            arquivo = open("tarefas.txt", "r", encoding="utf-8")
            linhas = arquivo.readlines()
            arquivo.close()

            quantidade = len(linhas)
            print(f"\n===== QUANTIDADE DE TAREFAS =====")
            print(f"Total de tarefas cadastradas: {quantidade}")
            
            if quantidade > 0:
                print("Tarefas registradas:")
                for tarefa in linhas:
                    print(f"- {tarefa.strip()}")
        except FileNotFoundError:
            print("\n===== QUANTIDADE DE TAREFAS =====")
            print("Total de tarefas cadastradas: 0 (Arquivo não encontrado)")

    elif opcao == 0:
        print("Programa encerrado!")----

    else:
        print("Opção inválida! Escolha uma opção válida.")

